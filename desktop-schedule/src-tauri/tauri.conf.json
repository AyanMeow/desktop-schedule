{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-schedule",
  "version": "0.2.3",
  "identifier": "com.zcode.schedule",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌面日程",
        "width": 900,
        "height": 675,
        "minWidth": 600,
        "minHeight": 450,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "taskbar",
        "title": "桌面日程 · 控制面板",
        "width": 300,
        "height": 200,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "visible": false,
        "url": "index.html#panel"
      },
      {
        "label": "memo",
        "title": "临时待办",
        "width": 280,
        "height": 360,
        "minWidth": 220,
        "minHeight": 240,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "index.html#memo"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
